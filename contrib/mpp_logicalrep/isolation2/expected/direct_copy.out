-- every row arrived, and on the segment the target's own policy puts it on:
-- a reference copy made by an ordinary INSERT lands the same way, segment by
-- segment, or the direct load put rows somewhere they do not belong
1:@db_name mpp_lr_dc: CREATE TABLE dc_ref (LIKE dc_same) DISTRIBUTED BY (id);
CREATE
1:@db_name mpp_lr_dc: INSERT INTO dc_ref SELECT * FROM dc_same;
INSERT 300000
1:@db_name mpp_lr_dc: SELECT count(*) AS segments_placed_differently FROM (SELECT gp_segment_id, sum(hashtext(id || '|' || v)) FROM dc_same GROUP BY 1 EXCEPT SELECT gp_segment_id, sum(hashtext(id || '|' || v)) FROM dc_ref GROUP BY 1) x;
