-- the live positions and the ones the last committed batch persisted are one
-- reading taken from two places
1:@db_name mpp_lr_mon: SELECT lr_wait($$SELECT (SELECT array_agg(cast(pos as text) ORDER BY source_segment) FROM gp_stat_mpp_subscription_segments WHERE subname = 'mon_sub') = (SELECT array_agg(cast(cast('0/0' as pg_lsn) + u.p as text) ORDER BY u.i) FROM gp_mpp_subscription s JOIN gp_subscription_progress g ON g.subid = s.subid, LATERAL unnest(g.seg_pos) WITH ORDINALITY AS u(p, i) WHERE s.subname = 'mon_sub')$$) AS view_agrees_with_progress;
 view_agrees_with_progress 
---------------------------
 t                         
(1 row)

-- ------------------------------------------------------------------
-- 4. stopped: the live columns go, the positions stay
-- ------------------------------------------------------------------
1:@db_name mpp_lr_mon: CREATE FUNCTION mon_snapshot() RETURNS void AS $$ BEGIN CREATE TEMP TABLE mon_pos AS SELECT source_segment, pos FROM gp_stat_mpp_subscription_segments WHERE subname = 'mon_sub'; END $$ LANGUAGE plpgsql;
CREATE
