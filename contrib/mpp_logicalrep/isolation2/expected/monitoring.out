-- ------------------------------------------------------------------
-- 3. under load
-- ------------------------------------------------------------------
1:@db_name mpp_lr_mon: CREATE TEMP TABLE mon_before AS SELECT batches, rows_applied, recoveries FROM gp_stat_mpp_subscription WHERE subname = 'mon_sub';
CREATE 1
2&: CALL mon_churn();  <waiting ...>
1:@db_name mpp_lr_mon: SELECT received_lsn IS NOT NULL AS receiving, apply_lag_bytes IS NOT NULL AS lag_is_a_number FROM gp_stat_mpp_subscription WHERE subname = 'mon_sub';
 receiving | lag_is_a_number 
-----------+-----------------
 t         | t               
(1 row)
2<:  <... completed>
CALL
-- 20000 seeded + 3000 inserted - 60 deleted
1:@db_name mpp_lr_mon: SELECT lr_wait('SELECT count(*) = 22940 FROM mon_t') AS caught_up;
 caught_up 
-----------
 t         
(1 row)
1:@db_name mpp_lr_mon: SELECT n.batches > b.batches AS batches_moved, n.rows_applied > b.rows_applied AS rows_moved, n.recoveries = b.recoveries AS no_recoveries FROM mon_before b, gp_stat_mpp_subscription n WHERE n.subname = 'mon_sub';
 batches_moved | rows_moved | no_recoveries 
---------------+------------+---------------
 t             | t          | t             
(1 row)
