-- The segments rolled their prepared transaction back and none of it was
-- announced.  There is no PREPARE to see: decoding only reached the prepare
-- record after the transaction had already been rolled back, and PostgreSQL
-- does not hand a subscriber a prepare whose fate it already knows.
SELECT count(*) FILTER (WHERE node >= 0 AND data LIKE 'ROLLBACK PREPARED%') > 0 AS rolled_back_on_the_segments, count(*) FILTER (WHERE node >= 0 AND data LIKE 'COMMIT PREPARED%') AS committed, count(*) FILTER (WHERE node = -1) AS announced, count(*) FILTER (WHERE data LIKE '%prepared then abandoned%') AS rows_in_either_stream FROM s7_raw;
 rolled_back_on_the_segments | committed | announced | rows_in_either_stream 
-----------------------------+-----------+-----------+-----------------------
 t                           | 0         | 0         | 0                     
(1 row)
-- the rows are gone from the table too
SELECT count(*) AS rows_left FROM s7_t WHERE v = 'prepared then abandoned';
 rows_left 
-----------
 0         
(1 row)

