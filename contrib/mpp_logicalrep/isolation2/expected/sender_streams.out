-- the coordinator carries the events and none of the rows
SELECT count(*) FILTER (WHERE data LIKE 'DISTRIBUTED COMMIT%') AS events, count(DISTINCT substring(data from 'gxid ([0-9]+)')) FILTER (WHERE data LIKE 'DISTRIBUTED COMMIT%') AS distinct_gxids, count(*) FILTER (WHERE data LIKE 'table %') AS rows_on_the_coordinator FROM s7_raw WHERE node = -1;
 events | distinct_gxids | rows_on_the_coordinator 
--------+----------------+-------------------------
 2      | 2              | 0                       
(1 row)

-- the two-phase one prepared under a gid that is its gxid, on every segment it
-- wrote; the one-phase one committed on its one segment with the gxid in the
-- commit itself
SELECT count(*) FILTER (WHERE data LIKE 'PREPARE TRANSACTION%') AS prepares, count(*) FILTER (WHERE data LIKE 'COMMIT PREPARED%') AS commit_prepareds, count(*) FILTER (WHERE data LIKE 'COMMIT%(gxid %') AS commits_with_a_gxid FROM s7_raw WHERE node >= 0;
 prepares | commit_prepareds | commits_with_a_gxid 
----------+------------------+---------------------
 3        | 3                | 1                   
(1 row)

SELECT (SELECT count(*) FROM (SELECT * FROM s7_announced EXCEPT SELECT * FROM s7_carried) a) AS announced_but_not_carried, (SELECT count(*) FROM (SELECT * FROM s7_carried EXCEPT SELECT * FROM s7_announced) b) AS carried_but_not_announced;
 announced_but_not_carried | carried_but_not_announced 
---------------------------+---------------------------
 0                         | 0                         
(1 row)

-- and the one that rolled back is in no stream at all
SELECT count(*) AS lines_mentioning_the_aborted_row FROM s7_raw WHERE data LIKE '%aborted%';
