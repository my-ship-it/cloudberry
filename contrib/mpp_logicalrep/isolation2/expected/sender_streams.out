-- the row and its gxid-less commit, on the segment that wrote it and nowhere else
SELECT node, count(*) FILTER (WHERE data LIKE '%utility%') AS the_row, count(*) FILTER (WHERE data LIKE 'COMMIT%' AND data NOT LIKE '%gxid%') AS commits_without_a_gxid, count(*) FILTER (WHERE data LIKE '%gxid%') AS anything_with_a_gxid FROM s7_raw WHERE node >= 0 GROUP BY node ORDER BY node;
 node | the_row | commits_without_a_gxid | anything_with_a_gxid 
------+---------+------------------------+----------------------
