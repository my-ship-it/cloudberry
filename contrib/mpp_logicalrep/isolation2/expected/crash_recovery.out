-- every round is there in full: none half-applied
1:@db_name mpp_lr_cr: SELECT count(*) AS rounds_not_of_twenty FROM (SELECT v, count(*) AS n FROM cr_t WHERE v LIKE 'round %' GROUP BY v) r WHERE n <> 20;
